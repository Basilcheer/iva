[Unit]
Description=Iva brain (nightly vault care: enforce, health, decay, MOC, git push)
After=network-online.target iva.service

[Service]
# Everything these units create (vault, transcripts, data/) must not be world-readable.
UMask=0077
Type=oneshot
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Один флок на все memory-юниты: роллапы и brain пишут CORE.md/MOC.md — параллельный
# запуск (1 января стартуют все четыре) не должен переписывать их одновременно.
# Страховка от молчаливого зависания хода (#104): убитый по таймауту юнит становится
# failed и виден в `iva doctor`.
# Именно TimeoutStartSec, а не RuntimeMaxSec: у Type=oneshot последний игнорируется
# (systemd-analyze verify: «has no effect in combination with Type=oneshot»), а свой
# таймаут старта у oneshot по умолчанию вовсе отключён.
TimeoutStartSec=3600
ExecStart=/usr/bin/flock -w 900 __PROJECT_DIR__/.memory.lock __NODE_BIN__ --env-file=.env scripts/memory/brain.ts
