[Unit]
Description=Iva daily update check
After=network-online.target
Wants=network-online.target

[Service]
# Everything these units create (vault, transcripts, data/) must not be world-readable.
UMask=0077
Type=oneshot
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env __DATA_DIR_ENV__ __NODE_BIN__ --env-file=.env scripts/check-update.mjs
