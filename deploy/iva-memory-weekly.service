[Unit]
Description=Iva memory rollup (weekly)
After=network-online.target iva.service

[Service]
# Everything these units create (vault, transcripts, data/) must not be world-readable.
UMask=0077
Type=oneshot
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__NODE_BIN__ --env-file=.env scripts/memory/rollup.ts weekly
