# Iva memory vault — git-backed (backup + Obsidian)
# Keep content: daily/, weekly/, monthly/, yearly/, summaries/, cards/, schema.json

# --- autograph runtime caches & derived data (regenerable) ---
.graph/
**/.graph/
.obsidian/workspace*.json

# --- soft-deletes from dedup ---
.trash/
**/.trash/

# --- rollup/doctor runtime session state ---
.session/

# --- недописанные файлы атомарной записи ---
# Карточки и MOC пишутся через «временный файл рядом + rename». Убитый по SIGKILL
# писатель оставляет такой файл на диске, а ночной brain делает `git add -A` — без этих
# строк огрызок уехал бы в историю vault. Два шаблона, потому что писателей два:
# python (tempfile.mkstemp → tmpXXXX.tmp) и TypeScript (fs-atomic → <файл>.tmp-<pid>-<uuid>).
*.tmp
*.tmp-*

# --- OS / editor noise ---
.DS_Store
Thumbs.db

# Note: schema.json is intentionally tracked (the schema IS the source of truth).
# A local-only override may live in schema.local.json:
schema.local.json
